# Copy outside version control. Generate unique secrets with openssl rand -hex 32.
DATABASE_URL=postgresql://partnership:replace-with-private-password@localhost:5432/partnership
POSTGRES_PASSWORD=replace-with-private-password
BETTER_AUTH_SECRET=
BOOTSTRAP_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# For local HTTP only. Internet-facing installations require HTTPS.
ALLOW_INSECURE_HTTP=true
